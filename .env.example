# Copy to .env and fill in. With no keys the app runs but has nothing to show
# until you add Plaid keys and link a bank (all data is live from Plaid).

# ---- Database (SQLite by default) ----
DATABASE_URL="file:./dev.db"

# ---- AI advisor (optional) ----
# Get a key at https://console.anthropic.com  → Settings → API Keys
# Without it, the advisor uses the built-in rule-based brain.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-6)
ADVISOR_MODEL=

# ---- Plaid bank linking (optional) ----
# Get sandbox keys at https://dashboard.plaid.com  → Developers → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox
# Request the recurring-transactions add-on (→ bills/subscriptions). This is a
# GATED Plaid product: only set to true if your Plaid account is approved for
# it, otherwise bank linking fails. Leave unset/false to keep linking working.
PLAID_ENABLE_RECURRING=
# Public URL of the webhook receiver (e.g. https://<your-app>/api/plaid/webhook)
# so Plaid pushes new-transaction updates instead of waiting for a manual Sync.
# After setting it on a deployed app, tap Sync once to register the existing
# item. Leave blank locally (Plaid can't reach localhost).
PLAID_WEBHOOK_URL=

# ---- Email alerts (optional) ----
# Spending alerts + digest are sent through Resend (https://resend.com).
# Both vars must be set AND the in-app Settings toggle turned on before
# anything is ever sent. ALERT_EMAIL_FROM must be a sender your Resend
# account has verified, e.g. "Clarity <alerts@yourdomain.com>".
RESEND_API_KEY=
ALERT_EMAIL_FROM=
# Shared secret (32+ random chars) protecting the digest endpoint. A cron
# (DO scheduled job or external) triggers it with the header — never put the
# secret in the URL:  curl -H "Authorization: Bearer $CRON_SECRET" \
#                          https://<your-app>/api/cron/digest
CRON_SECRET=

# ---- Error monitoring (optional) ----
# Sentry DSNs — leave blank to disable entirely. Amounts and PII are scrubbed
# from every event/breadcrumb before sending (see src/lib/monitoring.ts).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Accounts & sessions (multi-user) ----
# Signs the session JWTs (Auth.js). Generate: openssl rand -base64 32
AUTH_SECRET=
# Private-beta gate: signups require this code (8+ chars). Leave blank to keep
# signups closed entirely.
BETA_INVITE_CODE=
# Operator access: the account with this email gets the read-only /admin view
# (user roster + per-user data; every view is logged). Blank = no admin exists.
# Be straight with your testers that the operator can see their data.
ADMIN_EMAIL=
